          "file": "tonight.html",
          "title": "During the night",
          "grids": [
            "night"
          ],
          "sources": []
        },
        {
          "file": "leave-now.html",
          "title": "Leaving",
          "quick": [
            "I have to leave right now.",
            "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game."
          ],
          "grids": [
            {
              "id": "leave",
              "title": "Leaving",
              "columns": [
                "Situation",
                "Single player",
                "Co-op"
              ],
              "rows": [
                [
                  "Leaving, now or later",
                  "Save and quit",
                  "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game. If you have a moment, step somewhere safe first. Quitting may still crash; no fix is proven."
                ],
                [
                  "Telling the group",
                  "Nobody to tell",
                  "Type BRB, or tell the group later. No recap needed."
                ],
                [
                  "Everyone else",
                  "Keep playing",
                  "Pause quests until they return, especially if the leader left. Resume together."
                ],
                [
                  "Coming back",
                  "Load your save",
                  {
                    "text": "Join again the usual way",
                    "href": "join.html"
                  }
                ]
              ]
            }
          ],
          "sources": []
        }
      ]
