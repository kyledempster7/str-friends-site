        {
          "file": "setup.html",
          "title": "First-time setup",
          "grids": [
            {
              "id": "setup",
              "title": "Setting up the first time",
              "note": "Follow our Nexus collection page for installer choices.",
              "columns": [
                "Step",
                "Single player",
                "Co-op"
              ],
              "rows": [
                [
                  "Get Skyrim on Steam",
                  "Skyrim Special Edition on Steam",
                  "Special Edition. You don't need the Anniversary upgrade."
                ],
                [
                  "Run the cleanup kit",
                  "Nothing to do",
                  "Run the Friend Kit's Creation Club cleanup from Nexus. Follow its README. Never use Steam's \"Verify integrity\" afterwards."
                ],
                [
                  "Set up Vortex",
                  "Optional",
                  {
                    "text": "Install Vortex. Sign in. Enable Profile Management. Create an STR profile.",
                    "href": "https://www.nexusmods.com/vortex"
                  }
                ],
                [
                  "Add our mod collection",
                  "Optional, one at a time",
                  {
                    "text": "On Nexus, click Add collection. Follow the listed installer choices.",
                    "href": "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
                  }
                ],
                [
                  "Enable five plugins",
                  "Not needed",
                  "In Vortex's Plugins view, enable: SkyrimTogether.esp; SkyrimTogetherQuestPatches.esp; MysticismMagic.esp; better vanilla perks.esp; Imperious - Races of Skyrim.esp."
                ],
                [
                  "Launch the co-op game",
                  "Steam's Play button",
                  "Launch Skyrim Together (SkyrimTogether.exe). Steam's Play button starts the single-player game."
                ],
                [
                  "Save your new character",
                  "Play through Helgen",
                  "Finish Helgen Express offline. Save outside before connecting."
                ],
                [
                  "Check setup is complete",
                  "The main menu loads",
                  "Skyrim Together reaches the main menu. Your character is saved outside Helgen."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Our collection on Nexus",
              "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
            ]
          ]
        },
        {
          "file": "join.html",
          "title": "Joining a session",
          "quick": [
            "How do I join tonight?",
            "Launch Skyrim Together. Load your campaign character. Press F2. Choose Connect. Follow the party steps below."
          ],
          "grids": [
            {
              "id": "join",
              "title": "Joining",
              "columns": [
                "Step",
                "Single player",
                "Co-op"
              ],
              "rows": [
                [
                  "Launch the co-op game",
                  "Press Play on Steam",
                  "Launch Skyrim Together (SkyrimTogether.exe)."
                ],
                [
                  "Load your campaign character",
                  "Load any save",
                  "Load your campaign character, never a solo save."
                ],
                [
                  "Connect to our server",
                  "Not needed",
                  "Start any connection app the host requested through Nexus. Press F2 or Right Ctrl. Choose Connect. Enter the server details sent privately by the host."
                ],
                [
                  "Create the party (leader)",
                  "Not needed",
                  "Leader: press F2. Open Player Manager, then Party Menu. Click Launch party. Connected players join automatically."
                ],
                [
                  "Find everyone in the party",
                  "Not needed",
                  "Press F2. Open Player Manager, then Party Menu. Check Name, Lv. (level) and Location for everyone. Missing someone? Tell the leader."
                ],
                [
                  "Accept a missing invitation",
                  "Not needed",
                  "In Player Manager, open Invites. Choose \"Accept invite from\" your leader. Still missing? Tell the leader."
                ],
                [
                  "Meet and say READY",
                  "Just play",
                  "Go to the spot the host names on Discord. Press F2 or Right Ctrl. Type READY. Press Enter."
                ],
                [
                  "Report a connection problem",
                  "Reload or restart",
                  "Stop. Send the host the exact error message. Keep server details private."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Connecting to a server",
              "https://wiki.tiltedphoques.com/tilted-online/guides/client-setup/using-modorganizer2-mo2/playing-skyrim-together-reborn/connecting-to-a-server"
            ],
            [
              "Official play guide",
              "https://wiki.tiltedphoques.com/tilted-online/general-information/playguide"
            ]
          ]
        },
