              "columns": [
                "Build",
                "Before: single player",
                "After: our party"
              ],
              "rows": [
                [
                  "Healer",
                  "Heal yourself and your follower",
                  "Restoration first, Alteration for protection. Keep friends standing, and keep a weapon or spell for yourself."
                ],
                [
                  "Paladin",
                  "Sword, shield, heal yourself",
                  "One-handed, Block and Restoration. Switch between holding the line and emergency heals."
                ],
                [
                  "Necromancer-healer",
                  "Raise the dead",
                  "Restoration first, Conjuration second. Summon one helper; never raise corpses."
                ],
                [
                  "Death knight",
                  "A lone heavy warrior",
                  "Two-handed and Heavy Armor up front, one summoned helper, enough Restoration for yourself."
                ],
                [
                  "Two-handed guardian",
                  "Protect yourself and your follower",
                  "Two-handed, Block and Heavy Armor. Stand between enemies and friends; there's no taunt, so stay close."
                ],
                [
                  "Stealth ranger",
                  "Sneak and shoot everything",
                  "Archery and Sneak find the opening. Keep moving and shooting after you're spotted."
                ],
                [
                  "Gandalf-style wizard",
                  "Fragile on your own",
                  "Destruction and Alteration for fire and protection, backup Restoration. Earn a staff later."
                ],
                [
                  "Storyteller",
                  "Talk your way through",
                  "Speech, Restoration and a weapon. Keep a reliable damage fallback."
                ]
