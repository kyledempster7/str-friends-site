    {
      "num": "04",
      "label": "A night of adventure",
      "headline": "Join, play, and leave well",
      "icon": "<path d=\"M20 15.5A8.7 8.7 0 0 1 8.5 4 9 9 0 1 0 20 15.5Z\"/>",
      "pages": [
        {
          "file": "setup.html",
          "title": "First-time setup",
          "grids": [
            {
              "id": "setup",
              "title": "Setting up the first time, before and after",
              "note": "Do this once. The full steps and installer choices are on our Nexus collection page.",
              "columns": [
                "Step",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Get the game",
                  "Skyrim Special Edition on Steam",
                  "The same. You don't need the Anniversary upgrade."
                ],
                [
                  "Prepare the game",
                  "Nothing to do",
                  "Run the Friend Kit from our Nexus page once. It moves four built-in add-ons aside. Never use Steam's \"Verify integrity\" afterwards."
                ],
                [
                  "Install mods",
                  "Optional, one at a time",
                  {
                    "text": "Install our whole collection with Vortex from our Nexus page, picking the options it lists",
                    "href": "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
                  }
                ],
                [
                  "Check two switches",
                  "Not needed",
                  "In Vortex, make sure SkyrimTogether.esp and SkyrimTogetherQuestPatches.esp are turned on."
                ],
                [
                  "Start the game",
                  "Steam's Play button",
                  "Launch Skyrim Together (SkyrimTogether.exe). Steam's Play button skips the mods."
                ],
                [
                  "Make your character",
                  "Play through Helgen",
                  "Finish Helgen Express offline, then save outside before you ever connect."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Our collection on Nexus",
              "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
            ]
          ]
        },
        {
          "file": "join.html",
          "title": "Joining a session",
          "quick": [
            "How do I join tonight?",
            "Launch Skyrim Together, load your campaign character, press F2, choose Connect, then type READY."
          ],
          "grids": [
            {
              "id": "join",
              "title": "Joining, before and after",
              "columns": [
                "Step",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Start",
                  "Press Play on Steam",
                  "Launch Skyrim Together (SkyrimTogether.exe)."
                ],
                [
                  "Load",
                  "Load any save",
                  "Load your campaign character, never a solo save."
                ],
                [
                  "Connect",
                  "Not needed",
                  "Press F2 or Right Ctrl and choose Connect. Use the server address and password the host sends you privately. If the host asked you to run a connection app from our Nexus page, start it first."
                ],
                [
                  "Party",
                  "Not needed",
                  "The leader opens F2, Player Manager, Launch Party. Everyone else joins it automatically once connected."
                ],
                [
                  "Meet up",
                  "Just play",
                  "Meet the group and type READY."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Connecting to a server",
              "https://wiki.tiltedphoques.com/tilted-online/guides/client-setup/using-modorganizer2-mo2/playing-skyrim-together-reborn/connecting-to-a-server"
            ],
            [
              "Official play guide",
              "https://wiki.tiltedphoques.com/tilted-online/general-information/playguide"
            ]
          ]
        },
