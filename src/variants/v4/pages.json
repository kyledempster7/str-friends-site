    {
      "num": "04",
      "label": "A night of adventure",
      "headline": "Join, play, and leave well",
      "icon": "<path d=\"M20 15.5A8.7 8.7 0 0 1 8.5 4 9 9 0 1 0 20 15.5Z\"/>",
      "pages": [
        {
          "file": "setup.html",
          "title": "First-time setup",
          "grids": [
            {
              "id": "setup",
              "title": "Setting up the first time, before and after",
              "note": "Do this once. The full steps and installer choices are on our Nexus collection page.",
              "columns": [
                "Step",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Get the game",
                  "Skyrim Special Edition on Steam",
                  "The same. You don't need the Anniversary upgrade."
                ],
                [
                  "Prepare the game",
                  "Nothing to do",
                  "Run the Friend Kit's Creation Club cleanup from our Nexus page and follow its README. Never use Steam's \"Verify integrity\" afterwards."
                ],
                [
                  "Install Vortex",
                  "Optional",
                  {
                    "text": "Get Vortex from Nexus, sign in, turn on Profile Management, and create an STR profile",
                    "href": "https://www.nexusmods.com/vortex"
                  }
                ],
                [
                  "Install the mods",
                  "Optional, one at a time",
                  {
                    "text": "Click Add collection on our Nexus page and pick the installer options it lists",
                    "href": "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
                  }
                ],
                [
                  "Check five plugins",
                  "Not needed",
                  "In Vortex's Plugins view, turn on SkyrimTogether.esp, SkyrimTogetherQuestPatches.esp, MysticismMagic.esp, better vanilla perks.esp and Imperious - Races of Skyrim.esp."
                ],
                [
                  "Start the game",
                  "Steam's Play button",
                  "Launch Skyrim Together (SkyrimTogether.exe). Steam's Play button doesn't start the co-op client."
                ],
                [
                  "Make your character",
                  "Play through Helgen",
                  "Finish Helgen Express offline, then save outside before you ever connect."
                ],
                [
                  "You're ready when",
                  "The main menu loads",
                  "Skyrim Together reaches the main menu, and you have a character saved outside Helgen."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Our collection on Nexus",
              "https://www.nexusmods.com/games/skyrimspecialedition/collections/tv1bdy"
            ]
          ]
        },
        {
          "file": "join.html",
          "title": "Joining a session",
          "quick": [
            "How do I join tonight?",
            "Launch Skyrim Together, load your campaign character, press F2 and choose Connect, check you're in the leader's party, then type READY."
          ],
          "grids": [
            {
              "id": "join",
              "title": "Joining, before and after",
              "columns": [
                "Step",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Start",
                  "Press Play on Steam",
                  "Launch Skyrim Together (SkyrimTogether.exe)."
                ],
                [
                  "Load",
                  "Load any save",
                  "Load your campaign character, never a solo save."
                ],
                [
                  "Connect",
                  "Not needed",
                  "Press F2 or Right Ctrl and choose Connect. Use the server address and password the host sends you privately. If the host asked you to run a connection app from our Nexus page, start it first."
                ],
                [
                  "Party",
                  "Not needed",
                  "The leader presses F2, clicks Player Manager, then the Party Menu tab, and clicks Launch party. Everyone else joins automatically once connected."
                ],
                [
                  "Check your party",
                  "Not needed",
                  "Press F2, click Player Manager, then the Party Menu tab. It lists your party by Name, Lv. and Location. If the leader or you are missing, tell the leader before you start."
                ],
                [
                  "Meet up",
                  "Just play",
                  "Open chat with F2 or Right Ctrl, type READY and press Enter."
                ],
                [
                  "If it fails",
                  "Reload or restart",
                  "Stop and send the host the exact error message. Never post the server details publicly."
                ]
              ]
            }
          ],
          "sources": [
            [
              "Connecting to a server",
              "https://wiki.tiltedphoques.com/tilted-online/guides/client-setup/using-modorganizer2-mo2/playing-skyrim-together-reborn/connecting-to-a-server"
            ],
            [
              "Official play guide",
              "https://wiki.tiltedphoques.com/tilted-online/general-information/playguide"
            ]
          ]
        },
        {
          "file": "tonight.html",
          "title": "During the night",
          "grids": [
            "night"
          ],
          "sources": []
        },
        {
          "file": "leave-now.html",
          "title": "Leaving",
          "quick": [
            "I have to leave right now.",
            "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game."
          ],
          "grids": [
            {
              "id": "leave",
              "title": "Leaving, before and after",
              "columns": [
                "Situation",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Leaving, now or later",
                  "Save and quit",
                  "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game. If you have a moment, step somewhere safe first. Quitting may still crash; no fix is proven."
                ],
                [
                  "Telling the group",
                  "Nobody to tell",
                  "Type BRB, or tell the group later. No recap needed."
                ],
                [
                  "Everyone else",
                  "Keep playing",
                  "Stop advancing quests until they're back, especially if the leader left. Resume together."
                ],
                [
                  "Coming back",
                  "Load your save",
                  {
                    "text": "Join again the usual way",
                    "href": "join.html"
                  }
                ]
              ]
            }
          ],
          "sources": []
        }
      ]
    },
