          "grids": [
            "night"
          ],
          "sources": []
        },
        {
          "file": "leave-now.html",
          "title": "Leaving",
          "quick": [
            "I have to leave right now.",
            "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game."
          ],
          "grids": [
            {
              "id": "leave",
              "title": "Leaving, before and after",
              "columns": [
                "Situation",
                "Before: single player",
                "After: our co-op"
              ],
              "rows": [
                [
                  "Leave NOW",
                  "Quit",
                  "Save if possible. Let it finish. Press F2, choose Disconnect, then Proceed. Quit the game. Quitting may still crash; no fix is proven."
                ],
                [
                  "Normal goodbye",
                  "Save and quit",
                  "Get somewhere safe. Save and let it finish. Press F2, choose Disconnect, then Proceed. Quit the game."
                ],
                [
                  "Telling the group",
                  "Nobody to tell",
                  "Type BRB, or tell the group later. No recap needed."
                ],
                [
                  "Coming back",
                  "Load your save",
                  {
                    "text": "Join again the usual way",
                    "href": "join.html"
                  }
                ]
              ]
            }
          ],
          "sources": []
        }
      ]
